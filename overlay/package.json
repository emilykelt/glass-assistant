{
  "name": "overlay",
  "version": "1.0.0",
  "description": "Floating liquid-glass Claude overlay with Apple Calendar/Reminders integration",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "agent": "node agent/index.js",
    "idea": "node scripts/log-idea.mjs",
    "build:helper": "swiftc -O -o ekhelper ekhelper.swift && codesign --sign - --force ekhelper",
    "postinstall": "npm run build:helper || true",
    "jobs": "node scripts/job-watch.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "electron": "^42.2.0"
  }
}
