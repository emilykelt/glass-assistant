ANTHROPIC_API_KEY=your_key_here
OBSIDIAN_API_KEY=your_key_here
# Spotify app client id (developer.spotify.com/dashboard). Add http://127.0.0.1:8899/callback
# as a redirect URI on the app. Login happens once in a popup; tokens are stored in userData.
SPOTIFY_CLIENT_ID=

# --- Telegram texting agent (npm run agent) ---
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to talk to the bot. Everything else is refused.
# Text the bot once with this empty; the agent logs the incoming chat id.
TELEGRAM_ALLOWED_CHAT_IDS=
# Used when the model does not name a calendar / list. Run `./ekhelper calendars` for valid names.
DEFAULT_CALENDAR=
DEFAULT_REMINDER_LIST=
# Optional override; defaults to claude-opus-5.
AGENT_MODEL=
# Deepgram (voice mode, ⌘⇧M): Nova STT + v2 speak TTS. Optional overrides: DEEPGRAM_VOICE (default aura-2-athena-en),
# DEEPGRAM_SPEED (default 1), DEEPGRAM_EXPRESSIVITY (default 0).
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE=
